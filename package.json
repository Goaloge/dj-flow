{
  "name": "dj-flow",
  "version": "1.17.0",
  "description": "DJ FLOW – intelligenter Playlist-Generator, Tag-Editor und Mix-Analyzer für Engine DJ (macOS)",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "test": "node test/smoke.js && node test/encoders.js && node test/tags.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "author": "Michael Braun",
  "build": {
    "appId": "de.mrbrown.djflow",
    "productName": "DJ FLOW",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "lib/**",
      "public/**",
      "server.js",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "extraResources": [
        {
          "from": "build/ffmpeg/mac/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "build/ffmpeg/win/ffmpeg.exe",
          "to": "ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
